# Copie este arquivo pra .env.local e preencha os valores reais (nunca commitar .env.local —
# já está no .gitignore). As variáveis SEM prefixo REACT_APP_ só existem no servidor
# (funções serverless em /api), nunca chegam no bundle do frontend.

# Supabase
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notificações push (VAPID)
REACT_APP_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Meteoblue Weather API — usada só no backend (api/clima.js), nunca exposta no frontend.
METEOBLUE_API_KEY=
